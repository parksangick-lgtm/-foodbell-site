# OS / 편집기 부산물
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# 임시·테스트 파일
_*.html
/tmp/

# 파이썬이 자동으로 만드는 찌꺼기
__pycache__/
*.pyc

# Playwright MCP(브라우저 자동 시험)가 저절로 쌓는 화면·콘솔 기록 — 올라가면 foodbell.kr 에 공개된다
.playwright-mcp/

# 파이어베이스 관리자 열쇠 — 원래 C:\foodbell-keys 에만 두지만, 실수로 여기 들어와도 올라가지 않게
*-admin.json
# 파이어베이스 명령이 실패하면 남기는 기록
firebase-debug.log
firestore-debug.log

# 무거운 작업 파일 — 저장소에 올리지 않는다.
# (예전에 26MB 짜리 디자인 zip 이 `git add -A` 로 통째로 올라갔고,
#  나중에 지워도 저장소 기록에는 그대로 남는다.)
*.zip
*.psd
*.ai
*.mp4
# 단, 사이트에 실제로 거는 소개 영상(videos/, 한 개 5MB 이하로 줄인 것)은 올린다
!videos/*.mp4

# 디자인 캔버스 조립 결과물 (2.5MB) — design/*.dc.html 소스에서 다시 만들 수 있음
design/foodbell-design-system.html

# 견적서 아티팩트용 변형본 — build-quote-artifact.py 로 다시 만든다
sije-quote.artifact.html

# 클로드 디자인 캔버스 조립 결과물 (2.4MB) — design/worksheet/*.dc.html 에서 다시 만든다
design/worksheet/foodbell-sije-worksheet.html
