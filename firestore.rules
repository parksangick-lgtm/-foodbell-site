rules_version = '2';

// 시제행사 내역서 저장소의 보안 규칙 — 이 파일은 공개 저장소에 올라간다. 메일 주소를 여기 쓰지 않는다.
// 허락 = 구글로 로그인했고, 메일이 확인됐고, 그 메일이 `allow` 묶음에 있을 때 (allow 는 tools/sije_web/allow.py 가 고친다).
// 올리기: npx firebase-tools@15.34.0 deploy --only firestore:rules --project test   (실제는 --project default)
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allow/$(request.auth.token.email));
    }

    // 보기 명단(직원) — 일일 일정표만 읽는다. viewers 는 tools/sije_web/allow.py viewer-add 가 고친다.
    function viewer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/viewers/$(request.auth.token.email));
    }

    // 화면이 '나는 주인인가 · 보기 전용인가' 를 알도록 자기 메일의 문서만 읽힌다 (남의 것 · 목록 보기 · 쓰기는 안 됨)
    function isSelf(email) {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == email;
    }
    match /allow/{email} {
      allow get: if isSelf(email);
    }
    match /viewers/{email} {
      allow get: if isSelf(email);
    }

    match /events/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.status in ['확정', '미확정', '주문없음'];
      // 지우기는 아무도 못 한다 (행사 지우기는 1단계에 없음).

      match /images/{n} {
        allow read, create: if allowed();
      }
    }

    match /templates/{name} {
      allow read: if allowed();
    }

    // 2단계: 웹 서류 5종 — 서류 한 장 = 문서 하나 (서류 전체 모양 html + 목록 칸).
    // 300,000 글자 미만: 한글은 한 글자가 최대 3바이트라 문서 한 장 한도(1MB) 안쪽. 지금 서류는 약 5만 글자.
    match /docs/{id} {
      allow read: if allowed() || (viewer() && resource.data.kind == 'daily-schedule');
      allow delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.kind in ['sije-quote', 'event-quote', 'sije-worksheet', 'statement', 'staff-pay', 'daily-schedule']
        && request.resource.data.html is string
        && request.resource.data.html.size() < 300000;
    }

    // allow/* · viewers/* 는 위에서 자기 메일 문서 하나 읽기(get)만 된다. 그 밖의 모든 곳은 규칙이 없으므로 모두 거부된다.
  }
}
